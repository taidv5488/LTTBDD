private val ScreenBg = Color(0xFFF8FAFC)
private val AvatarBg = Color(0xFFCFE3F5)
private val Accent = Color(0xFF1FA67A)
private val BorderGray = Color(0xFFE2E5E9)

@Composable
fun ProfileScreen(
    name: String,
    studentId: String,
    avatarRes: Int,
    onBack: () -> Unit,
    onEdit: () -> Unit,
) {
    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(ScreenBg)
            .statusBarsPadding()
            .padding(horizontal = 16.dp, vertical = 12.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
    ) {
        // Top bar
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.SpaceBetween,
        ) {
            SquareIconButton(
                onClick = onBack,
                icon = Icons.AutoMirrored.Filled.ArrowBack,
                contentDescription = "Back",
                tint = Color.Black,
                borderColor = BorderGray,
            )
            SquareIconButton(
                onClick = onEdit,
                icon = Icons.Outlined.Edit,
                contentDescription = "Edit profile",
                tint = Accent,
                borderColor = Accent.copy(alpha = 0.4f),
            )
        }

        Spacer(Modifier.height(56.dp))

        // Avatar
        Image(
            painter = painterResource(avatarRes),
            contentDescription = "Avatar",
            contentScale = ContentScale.Crop,
            modifier = Modifier
                .size(136.dp)
                .clip(CircleShape)
                .background(AvatarBg),
        )

        Spacer(Modifier.height(16.dp))

        Text(
            text = name,
            fontSize = 22.sp,
            fontWeight = FontWeight.Bold,
            color = Color(0xFF111111),
        )
        Spacer(Modifier.height(2.dp))
        Text(
            text = studentId,
            fontSize = 16.sp,
            color = Color(0xFF6B7280),
        )
    }
}

@Composable
private fun SquareIconButton(
    onClick: () -> Unit,
    icon: androidx.compose.ui.graphics.vector.ImageVector,
    contentDescription: String,
    tint: Color,
    borderColor: Color,
) {
    Surface(
        onClick = onClick,
        shape = RoundedCornerShape(10.dp),
        color = Color.White,
        border = BorderStroke(1.dp, borderColor),
        modifier = Modifier.size(40.dp),
    ) {
        Box(contentAlignment = Alignment.Center) {
            Icon(icon, contentDescription, tint = tint, modifier = Modifier.size(18.dp))
        }
    }
}

